# Domaine de production
DOMAIN=edutrack.live

# Image tag shared by both services
TAG=latest

# Backend (ASP.NET Core)
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080

# Frontend (TanStack Start / Vite)
FRONTEND_PORT=3000
# Baked into the frontend at build time (Vite import.meta.env)
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=dev_account
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=dev_edutrack
POSTGRES_PORT=5432

# Backend connection string (ASP.NET Core reads ConnectionStrings:DefaultConnection)
CONNECTION_STRING=Host=postgres;Port=5432;Database=dev_edutrack;Username=dev_account;Password=dev_password

# Nginx reverse proxy
NGINX_PORT=80

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=dev_admin
GRAFANA_ADMIN_PASSWORD=dev_password
SEQ_PORT=5341
SEQ_UI_PORT=8081
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
